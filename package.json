{
  "name": "backslash-graph-api",
  "version": "1.0.0",
  "description": "Graph Query API for microservice route analysis",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "graph",
    "microservices",
    "fastify",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  }
}
